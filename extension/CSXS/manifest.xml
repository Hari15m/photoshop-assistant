<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.photoshopassistant" ExtensionBundleVersion="1.4.0" ExtensionBundleName="Photoshop Assistant">
  <ExtensionList><Extension Id="com.photoshopassistant.panel" Version="1.4.0"/></ExtensionList>
  <ExecutionEnvironment>
    <HostList><Host Name="PHXS" Version="[21.0,21.9]"/><Host Name="PHSP" Version="[21.0,21.9]"/></HostList>
    <LocaleList><Locale Code="All"/></LocaleList>
    <RequiredRuntimeList><RequiredRuntime Name="CSXS" Version="9.0"/></RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.photoshopassistant.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle><AutoVisible>true</AutoVisible></Lifecycle>
        <UI><Type>Panel</Type><Menu>Photoshop Assistant</Menu>
          <Geometry><Size><Height>600</Height><Width>360</Width></Size></Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
